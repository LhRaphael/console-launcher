{
  "configVersion": 6,
  "romRoot": "~/ROMs",
  "emulatorDir": "~/emulators",
  "overlayWrapper": "linosd-run",
  "showEmptySystems": true,

  "systems": [
    {
      "id": "snes", "name": "Super Nintendo", "short": "SNES", "color": "#8b6cf0", "dir": "snes",
      "emulator": "Snes9x", "exe": "Snes9x-*.AppImage",
      "args": ["{options}", "{rom}"],
      "openArgs": [],
      "extensions": ["sfc", "smc", "fig", "swc", "bs", "zip"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "true",
          "ini": { "file": "~/.config/snes9x/snes9x.conf", "section": "Display", "key": "FullscreenOnOpen", "create": true },
          "options": [
            { "label": "Ligada", "value": "true",
              "set": [ { "file": "~/.config/snes9x/snes9x.conf", "section": "Window State", "key": "UIVisible", "value": "false" } ] },
            { "label": "Desligada", "value": "false",
              "set": [ { "file": "~/.config/snes9x/snes9x.conf", "section": "Window State", "key": "UIVisible", "value": "true" } ] } ] }
      ]
    },
    {
      "id": "n64", "name": "Nintendo 64", "short": "N64", "color": "#3cb44a", "dir": "n64",
      "emulator": "RMG", "exe": "RMG*.AppImage",
      "fallback": ["RMG", "flatpak:com.github.Rosalie241.RMG"],
      "args": ["--nogui", "--quit-after-emulation", "{options}", "{rom}"],
      "openArgs": [],
      "extensions": ["z64", "n64", "v64", "ndd", "d64", "zip", "7z"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["--fullscreen"] },
                       { "label": "Desligada", "value": "off" } ] }
      ]
    },
    {
      "id": "gba", "name": "Game Boy Advance", "short": "GBA", "color": "#7b68ee", "dir": "gba",
      "emulator": "mGBA", "exe": "mGBA-*.AppImage",
      "fallback": ["mgba-qt", "flatpak:io.mgba.mGBA"],
      "args": ["{options}", "{rom}"],
      "openArgs": [],
      "extensions": ["gba", "agb", "gb", "gbc", "sgb", "zip", "7z"],
      "bios": { "type": "mgba" },
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-f"] },
                       { "label": "Desligada", "value": "off" } ] },
        { "id": "bios", "label": "Usar a BIOS importada", "default": "",
          "description": "Sem BIOS o mGBA usa a dele, embutida",
          "args": ["-C", "useBios={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Sim", "value": "1" },
                       { "label": "Não", "value": "0" } ] },
        { "id": "intro", "label": "Abertura da BIOS", "default": "",
          "args": ["-C", "skipBios={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Mostrar", "value": "0" },
                       { "label": "Pular", "value": "1" } ] },
        { "id": "scale", "label": "Tamanho da janela", "default": "",
          "description": "Só vale fora da tela cheia",
          "args": ["-{value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "3x", "value": "3" },
                       { "label": "4x", "value": "4" },
                       { "label": "6x", "value": "6" } ] }
      ]
    },
    {
      "id": "ps1", "name": "PlayStation", "short": "PS1", "color": "#a3acbf", "dir": "ps1",
      "emulator": "DuckStation", "exe": "DuckStation-x64*.AppImage",
      "args": ["-batch", "{options}", "--", "{rom}"],
      "openArgs": [],
      "extensions": ["cue", "chd", "pbp", "m3u", "ecm", "mds", "ccd"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-fullscreen"] },
                       { "label": "Desligada", "value": "off", "args": ["-nofullscreen"] } ] },
        { "id": "boot", "label": "Abertura do console (logo da BIOS)", "default": "fast",
          "options": [ { "label": "Pular", "value": "fast", "args": ["-fastboot"] },
                       { "label": "Mostrar", "value": "slow", "args": ["-slowboot"] } ] },
        { "id": "renderer", "label": "Renderizador", "default": "",
          "ini": { "file": "~/.local/share/duckstation/settings.ini", "section": "GPU", "key": "Renderer" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Automático", "value": "Automatic" },
                       { "label": "Vulkan", "value": "Vulkan" },
                       { "label": "OpenGL", "value": "OpenGL" },
                       { "label": "Software (mais compatível)", "value": "Software" } ] },
        { "id": "scale", "label": "Resolução interna", "default": "",
          "ini": { "file": "~/.local/share/duckstation/settings.ini", "section": "GPU", "key": "ResolutionScale" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Nativa (1x)", "value": "1" },
                       { "label": "2x (480p)", "value": "2" },
                       { "label": "3x (720p)", "value": "3" },
                       { "label": "4x (960p)", "value": "4" },
                       { "label": "5x (1200p)", "value": "5" },
                       { "label": "6x (1440p)", "value": "6" },
                       { "label": "9x (4K)", "value": "9" } ] },
        { "id": "widescreen", "label": "Tela larga 16:9 (hack)", "default": "",
          "description": "Pode causar falhas gráficas em alguns jogos",
          "ini": { "file": "~/.local/share/duckstation/settings.ini", "section": "GPU", "key": "WidescreenHack" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Ligada", "value": "true" },
                       { "label": "Desligada", "value": "false" } ] },
        { "id": "pgxp", "label": "Correção de geometria (PGXP)", "default": "",
          "description": "Reduz o \"tremido\" dos polígonos",
          "ini": { "file": "~/.local/share/duckstation/settings.ini", "section": "GPU", "key": "PGXPEnable" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Ligada", "value": "true" },
                       { "label": "Desligada", "value": "false" } ] }
      ]
    },
    {
      "id": "ps2", "name": "PlayStation 2", "short": "PS2", "color": "#3d74f0", "dir": "ps2",
      "emulator": "PCSX2", "exe": "pcsx2-*.AppImage",
      "args": ["-batch", "{options}", "--", "{rom}"],
      "openArgs": [],
      "extensions": ["iso", "chd", "cso", "zso"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-fullscreen"] },
                       { "label": "Desligada", "value": "off", "args": ["-nofullscreen"] } ] },
        { "id": "boot", "label": "Abertura do console (logo da BIOS)", "default": "fast",
          "options": [ { "label": "Pular", "value": "fast", "args": ["-fastboot"] },
                       { "label": "Mostrar", "value": "slow", "args": ["-slowboot"] } ] },
        { "id": "renderer", "label": "Renderizador", "default": "",
          "ini": { "file": "~/.config/PCSX2/inis/PCSX2.ini", "section": "EmuCore/GS", "key": "Renderer" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Automático", "value": "-1" },
                       { "label": "Vulkan", "value": "14" },
                       { "label": "OpenGL", "value": "12" },
                       { "label": "Software (mais compatível)", "value": "13" } ] },
        { "id": "scale", "label": "Resolução interna", "default": "",
          "ini": { "file": "~/.config/PCSX2/inis/PCSX2.ini", "section": "EmuCore/GS", "key": "upscale_multiplier" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Nativa (1x)", "value": "1" },
                       { "label": "2x (720p)", "value": "2" },
                       { "label": "3x (1080p)", "value": "3" },
                       { "label": "4x (1440p)", "value": "4" },
                       { "label": "6x (4K)", "value": "6" } ] },
        { "id": "widescreen", "label": "Patches de tela larga 16:9", "default": "",
          "ini": { "file": "~/.config/PCSX2/inis/PCSX2.ini", "section": "EmuCore", "key": "EnableWideScreenPatches" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Ligados", "value": "true" },
                       { "label": "Desligados", "value": "false" } ] }
      ]
    },
    {
      "id": "ps3", "name": "PlayStation 3", "short": "PS3", "color": "#6c79ff", "dir": "ps3",
      "emulator": "RPCS3", "exe": "rpcs3-*.AppImage",
      "args": ["--no-gui", "{options}", "{rom}"],
      "openArgs": [],
      "folderMarkers": ["PS3_GAME/USRDIR/EBOOT.BIN", "USRDIR/EBOOT.BIN"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "true",
          "yaml": { "file": "~/.config/rpcs3/config.yml", "section": "Miscellaneous", "key": "Start games in fullscreen mode" },
          "options": [ { "label": "Ligada", "value": "true" },
                       { "label": "Desligada", "value": "false" } ] },
        { "id": "renderer", "label": "Renderizador", "default": "",
          "yaml": { "file": "~/.config/rpcs3/config.yml", "section": "Video", "key": "Renderer" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Vulkan", "value": "Vulkan" },
                       { "label": "OpenGL", "value": "OpenGL" } ] },
        { "id": "scale", "label": "Resolução interna", "default": "",
          "yaml": { "file": "~/.config/rpcs3/config.yml", "section": "Video", "key": "Resolution Scale" },
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Nativa (720p)", "value": "100" },
                       { "label": "150% (1080p)", "value": "150" },
                       { "label": "200% (1440p)", "value": "200" },
                       { "label": "300% (4K)", "value": "300" } ] }
      ]
    },
    {
      "id": "ps4", "name": "PlayStation 4", "short": "PS4", "color": "#2f8cff", "dir": "ps4",
      "emulator": "shadPS4", "exe": "shadPS4QtLauncher*.AppImage",
      "args": ["-d", "-g", "{rom}", "--", "{options}"],
      "openArgs": [],
      "folderMarkers": ["eboot.bin"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-f", "true"] },
                       { "label": "Desligada", "value": "off", "args": ["-f", "false"] } ] }
      ]
    },
    {
      "id": "xbox", "name": "Xbox", "short": "Xbox", "color": "#4cc35a", "dir": "xbox",
      "emulator": "xemu", "exe": "xemu-*.AppImage",
      "args": ["{options}", "-dvd_path", "{rom}"],
      "openArgs": [],
      "extensions": ["iso"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-full-screen"] },
                       { "label": "Desligada", "value": "off" } ] }
      ]
    },
    {
      "id": "gc", "name": "GameCube", "short": "GameCube", "color": "#8a63e8", "dir": "gc",
      "emulator": "Dolphin", "exe": "flatpak",
      "args": ["run", "org.DolphinEmu.dolphin-emu", "-b", "{options}", "-e", "{rom}"],
      "openArgs": ["run", "org.DolphinEmu.dolphin-emu"],
      "extensions": ["iso", "gcm", "gcz", "rvz", "ciso"],
      "overlay": false,
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-C", "Dolphin.Display.Fullscreen=True"] },
                       { "label": "Desligada", "value": "off", "args": ["-C", "Dolphin.Display.Fullscreen=False"] } ] },
        { "id": "renderer", "label": "Renderizador", "default": "",
          "args": ["-C", "Dolphin.Core.GFXBackend={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Vulkan", "value": "Vulkan" },
                       { "label": "OpenGL", "value": "OGL" } ] },
        { "id": "scale", "label": "Resolução interna", "default": "",
          "args": ["-C", "Graphics.Settings.InternalResolution={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Nativa (480p)", "value": "1" },
                       { "label": "2x (720p)", "value": "2" },
                       { "label": "3x (1080p)", "value": "3" },
                       { "label": "4x (1440p)", "value": "4" },
                       { "label": "6x (4K)", "value": "6" } ] },
        { "id": "widescreen", "label": "Tela larga 16:9 (hack)", "default": "",
          "description": "Pode causar falhas gráficas em alguns jogos",
          "args": ["-C", "Graphics.Settings.wideScreenHack={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Ligada", "value": "True" },
                       { "label": "Desligada", "value": "False" } ] }
      ]
    },
    {
      "id": "wii", "name": "Wii", "short": "Wii", "color": "#3fc4ef", "dir": "wii",
      "emulator": "Dolphin", "exe": "flatpak",
      "args": ["run", "org.DolphinEmu.dolphin-emu", "-b", "{options}", "-e", "{rom}"],
      "openArgs": ["run", "org.DolphinEmu.dolphin-emu"],
      "extensions": ["iso", "wbfs", "rvz", "gcz", "wia"],
      "overlay": false,
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-C", "Dolphin.Display.Fullscreen=True"] },
                       { "label": "Desligada", "value": "off", "args": ["-C", "Dolphin.Display.Fullscreen=False"] } ] },
        { "id": "renderer", "label": "Renderizador", "default": "",
          "args": ["-C", "Dolphin.Core.GFXBackend={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Vulkan", "value": "Vulkan" },
                       { "label": "OpenGL", "value": "OGL" } ] },
        { "id": "scale", "label": "Resolução interna", "default": "",
          "args": ["-C", "Graphics.Settings.InternalResolution={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Nativa (480p)", "value": "1" },
                       { "label": "2x (720p)", "value": "2" },
                       { "label": "3x (1080p)", "value": "3" },
                       { "label": "4x (1440p)", "value": "4" },
                       { "label": "6x (4K)", "value": "6" } ] },
        { "id": "widescreen", "label": "Tela larga 16:9 (hack)", "default": "",
          "description": "Pode causar falhas gráficas em alguns jogos",
          "args": ["-C", "Graphics.Settings.wideScreenHack={value}"],
          "options": [ { "label": "Padrão do emulador", "value": "" },
                       { "label": "Ligada", "value": "True" },
                       { "label": "Desligada", "value": "False" } ] }
      ]
    },
    {
      "id": "switch", "name": "Nintendo Switch", "short": "Switch", "color": "#ff3b4a", "dir": "switch",
      "emulator": "Eden", "exe": "Eden-Linux-*.AppImage",
      "args": ["{options}", "-g", "{rom}"],
      "openArgs": [],
      "extensions": ["nsp", "xci"],
      "settings": [
        { "id": "fullscreen", "label": "Tela cheia", "default": "on",
          "options": [ { "label": "Ligada", "value": "on", "args": ["-f"] },
                       { "label": "Desligada", "value": "off" } ] }
      ]
    }
  ]
}
